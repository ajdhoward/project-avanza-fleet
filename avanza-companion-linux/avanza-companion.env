# /etc/avanza/companion.env  (chmod 600 — contains the app control token)
ORCH_URL=https://avanza-edge-orchestrator.YOUR-SUBDOMAIN.workers.dev
APP_TOKEN=REPLACE_with_APP_CONTROL_KEY_value
INTERVAL=30
BOOST_TTL=3600
GRACE_CYCLES=2
# SELF_IP=            # optional: force the LAN IP to register (auto-detected otherwise)
