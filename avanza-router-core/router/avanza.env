# PROJECT AVANZA / router environment / install to /etc/avanza/agent.env (chmod 600)
ORCH_URL=https://avanza-edge-orchestrator.YOUR-SUBDOMAIN.workers.dev
AGENT_HMAC_KEY=REPLACE_with_wrangler_secret_value_32B_hex
INTERVAL=60
OVERLAY_WARN=85
OVERLAY_CRIT=94
RB_DIR=/overlay/avanza/rollback
RB_KEEP=6
RB_WINDOW=600
TUNNEL_ENABLED=0
DEVICE_ID=avanza-router
DEVICE_ROLE=primary
PLC_ENABLED=1
PLC_IF=lan1
FLEET_PEER_IP=192.168.99.2
MIN_EPOCH=1767225600
