#!/bin/sh /etc/rc.common
# PROJECT AVANZA / procd unit for the secondary switch node agent
USE_PROCD=1
START=95
STOP=10

PROG=/usr/libexec/avanza/secondary_agent.sh

start_service() {
	[ -x "$PROG" ] || return 1
	procd_open_instance avanza-switch
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_set_param limits nofile="512 2048"
	procd_close_instance
}
